# Copy this file to .env for local testing. Leave DATABASE_URL and SMTP values blank
# until you have the real credentials. Never commit .env or real secrets.

# Initial Super Admin account (password must be at least 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Clearbot Super Admin

# Session signing secret: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# PostgreSQL (set this to the Internal Database URL from Render in production)
DATABASE_URL=
DATABASE_SSL=true

# New enquiry notifications
ENQUIRY_NOTIFY_TO=sid@clearbot.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Canonical website origin used by sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://www.clearbot.org
