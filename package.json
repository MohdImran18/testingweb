{
    "name":  "clearbot-premium-nextjs",
    "version":  "2.0.0",
    "private":  true,
    "scripts":  {
                    "dev":  "concurrently -k -n API,NEXT -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
                    "dev:api":  "node --watch server.js",
                    "dev:web":  "next dev -p 3001",
                    "build":  "next build",
                    "start":  "concurrently -k -n API,NEXT -c blue,green \"npm:start:api\" \"npm:start:web\"",
                    "start:api":  "node server.js",
                    "start:web":  "next start -H 0.0.0.0 -p $PORT"
                },
    "engines":  {
                    "node":  "\u003e=20.9.0"
                },
    "dependencies":  {
                         "concurrently":  "^9.2.1",
                         "framer-motion":  "^12.23.24",
                         "html-react-parser":  "^5.2.10",
                         "lucide-react":  "^0.552.0",
                         "next":  "^16.0.1",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0"
                     },
    "devDependencies":  {
                            "@tailwindcss/postcss":  "^4.1.17",
                            "@types/node":  "26.6.6",
                            "@types/react":  "19.3.0",
                            "tailwindcss":  "^4.1.17",
                            "typescript":  "^5.9.3"
                        }
}